{
    "python.defaultInterpreterPath": "${workspaceFolder}/Ch4/venv/Scripts/python.exe",
    "emmet.includeLanguages": {
        "django-html": "html"
    },
    "emmet.triggerExpansionOnTab": true,
    "[python]": {
        "path-autocomplete.pathMappings": {
            "$root": "${fileDirname}/templates"
        }
    },
    "[django-html]": {
        "path-autocomplete.pathMappings": {
            "$root": [
                "${fileDirname}/..",
                "${fileDirname}/../../static"
            ]
        },
        "path-autocomplete.excludedItems": {
            "**/templates/**": {
                "when": "**/*.html",
                "context": "\\{%\\s*static"
            },
            "**/static/**": {
                "when": "**/*.html",
                "context": "\\{%\\s*(extends|include)"
            }
        }
    },
    "auto-close-tag.activationOnLanguage": [
        "django-html",
        "xml",
        "php",
        "blade",
        "ejs",
        "jinja",
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact",
        "plaintext",
        "markdown",
        "vue",
        "liquid",
        "erb",
        "lang-cfml",
        "cfml",
        "HTML (EEx)",
        "HTML (Eex)",
        "plist"
    ]
}
